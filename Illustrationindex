<title>Adam Falp Illustration</title>

<style>

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #000;
    font-family: Arial, Helvetica, sans-serif;
    color: white;
}


/* =========================
   MAIN CONTAINER
========================= */

.container {

    width: 900px;

    max-width: 92%;

    margin: 80px auto;

    border: 1px solid white;

    padding: 25px;

}


/* =========================
   GALLERY
========================= */

.gallery {

    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 30px;

}


/* =========================
   INDIVIDUAL WORK
========================= */

.work {

    position: relative;

    background: #000;

    overflow: hidden;

}


.work img {

    width: 100%;

    display: block;

    border: 1px solid white;

}


/* =========================
   LABEL
========================= */

.label {

    padding: 12px 4px 5px;

    color: white;

    font-size: 13px;

    line-height: 1.5;

    letter-spacing: 1px;

}


.label strong {

    font-size: 14px;

}


/* =========================
   HOVER
========================= */

.work img {

    transition: opacity 0.25s ease;

}


.work:hover img {

    opacity: 0.75;

}


/* =========================
   BACK BUTTON
========================= */

.back {

    display: inline-block;

    margin-top: 40px;

    padding: 12px 30px;

    border: 1px solid white;

    color: white;

    background: black;

    text-decoration: none;

    font-size: 13px;

    letter-spacing: 3px;

    transition: 0.2s;

}


.back:hover {

    background: white;

    color: black;

}


/* =========================
   MOBILE
========================= */

@media (max-width: 650px) {

    .container {

        margin: 30px auto;

        padding: 15px;

    }

    .gallery {

        grid-template-columns: 1fr;

        gap: 25px;

    }

}

</style>

</head>


